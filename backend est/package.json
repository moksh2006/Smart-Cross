{
  "name": "smartcross-backend",
  "version": "2.0.0",
  "description": "SmartCross - Patiala Railway Phatak Real-Time Prediction System Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/seeds/seed.js",
    "verify-coords": "node scripts/verifyCoordinates.js",
    "build-track": "node scripts/buildCorridorTrack.js",
    "check-railradar": "node scripts/checkRailRadar.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns integration",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.2",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.1",
    "nodemon": "^3.1.7",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  }
}
