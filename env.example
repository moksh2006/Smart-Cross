# ---------------------------------------------------------------------------
# SmartCross configuration. Copy to `.env` (repo root for Docker Compose, or
# backend/.env for `npm run dev`). NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Core
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
# Leave empty in development to use an in-memory MongoDB (data is lost on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/smartcross
# Only honoured outside production
ALLOW_IN_MEMORY_DB=true
LOG_LEVEL=info

# --- Security (required in production)
ADMIN_PASSWORD=change-me-smartcross
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
API_RATE_LIMIT_PER_MINUTE=300

# --- Data mode: AUTO (LIVE if an API key is set, else SIMULATION) | LIVE | SIMULATION
DATA_MODE=AUTO

# --- RailRadar (https://railradar.in/docs). Without a key the app runs in simulation mode.
RAILRADAR_API_KEY=
RAILRADAR_MONTHLY_QUOTA=1000
RAILRADAR_PER_MINUTE_LIMIT=10
RAILRADAR_QUOTA_RESERVE_PERCENT=5
RAILRADAR_BILLING_DAY=1
RAILRADAR_TIMEOUT_MS=10000
RAILRADAR_MAX_RETRIES=2
# Fetch timetables from /v1/trains/{n} (costs 1 call per train per refresh)
FETCH_SCHEDULES_FROM_API=false
SCHEDULE_REFRESH_DAYS=30

# --- Adaptive polling (live mode)
PRE_POLL_MINUTES=20
POST_CLEAR_POLL_MINUTES=10
POLL_INTERVAL_NEAR_SECONDS=45
POLL_INTERVAL_MID_SECONDS=90
POLL_INTERVAL_FAR_SECONDS=180

# --- Prediction thresholds (software estimates, NOT verified gate timings;
#     also editable at runtime in Admin > Prediction thresholds)
CLOSING_SOON_THRESHOLD_MINUTES=10
CLOSED_DISTANCE_METERS=1200
CLOSED_ETA_MINUTES=2.5
CLEARANCE_DISTANCE_METERS=300
CLEARANCE_BUFFER_SECONDS=30
TRAIN_LENGTH_METERS=550
STALE_DATA_THRESHOLD_SECONDS=180
MAX_DEAD_RECKONING_SECONDS=900
MIN_HISTORICAL_SAMPLES=5
DEFAULT_CORRIDOR_SPEED_KMH=45

# --- Data retention (days, TTL indexes)
RETENTION_SNAPSHOT_DAYS=14
RETENTION_AUDIT_DAYS=60
RETENTION_ALERT_DAYS=90
RETENTION_EVENT_DAYS=365
